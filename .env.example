# Photo Sensei — environment template.
# Copy this file to ".env" and fill in your real values. The .env file is gitignored — never commit it.

# Required: your Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456789:AAExample-replace-with-your-real-token

# Optional: allowlist of chat IDs the bot will serve (comma-separated). Leave empty/unset to serve
# everyone. A channel/supergroup ID looks like -1001234567890; a personal DM is a positive number.
# Message the bot "/id" in any chat to discover its ID.
# AUTHORIZED_CHAT_IDS=-1001234567890,123456789

# Optional overrides (defaults shown)
# PHOTO_SENSEI_MODEL=claude-opus-4-8        # claude-sonnet-4-6 is ~2-3x faster
# PHOTO_SENSEI_TIMEOUT=1200                 # seconds; full Opus pipeline runs 7-12 min
# PHOTO_SENSEI_PERMISSION_MODE=bypassPermissions
# PHOTO_SENSEI_OLLAMA_VISION=qwen2.5vl

# Optional: Instagram Graph API for the /sync-insights loop (Business/Creator account + Meta app).
# Insights only — the API cannot post music or detect trending sounds. See README.md.
# IG_ACCESS_TOKEN=your-long-lived-token
# IG_USER_ID=your-ig-business-user-id
